# Local development (all three backend services on localhost):
# VITE_AUTH_SERVICE_URL=http://localhost:8081
# VITE_JOB_SERVICE_URL=http://localhost:8082
# VITE_APPLICATION_SERVICE_URL=http://localhost:8083

# Hosted frontend + local backend via a single ngrok tunnel in front of
# dev-proxy.js (path-prefix routes to the three services — see the file at
# the repo root for details). ngrok's free tier only grants one public URL,
# so all three env vars point at the same tunnel host with different paths.
VITE_AUTH_SERVICE_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.dev/auth
VITE_JOB_SERVICE_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.dev/jobs
VITE_APPLICATION_SERVICE_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.dev/apps
